rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() { 
      return request.auth != null; 
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Safe user role detection from auth token custom claims or user profile document
    function getUserRole() {
      return isAuthenticated()
        ? (request.auth.token != null && request.auth.token.role != null
            ? request.auth.token.role
            : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
                ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
                : 'student'))
        : null;
    }

    // Role checking helper with case insensitivity
    function isRole(r) { 
      return isAuthenticated() && (
        getUserRole() == r || 
        getUserRole() == r.toLowerCase() || 
        getUserRole() == r.toUpperCase()
      ); 
    }

    function isTPO() {
      return isRole('tpo') || isRole('admin');
    }

    function isRecruiter() {
      return isRole('recruiter') || isTPO();
    }

    // 1. User Profiles & Subcollections
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if isOwner(uid) || isTPO();
      allow update: if isOwner(uid) || isTPO() || isRecruiter();
      allow delete: if isTPO();
      
      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // 2. Placement Drives & Applications / Subcollections
    match /drives/{driveId} {
      allow read: if isAuthenticated();
      allow write: if isRecruiter() || isTPO();

      match /applications/{appId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated();
        allow delete: if isTPO() || isRecruiter();
      }

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // 3. Notifications & Announcements
    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow write: if isRecruiter() || isTPO();
    }

    // 4. Proctored Exams, Question Banks & Exam Results
    match /exams/{examId} {
      allow read: if isAuthenticated();
      allow write: if isTPO() || isRecruiter();
    }

    match /examResults/{resultId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isTPO();
    }

    match /question_banks/{bankId} {
      allow read: if isAuthenticated();
      allow write: if isTPO() || isRecruiter();
    }

    // 5. Live Interview Rooms & Schedules
    match /interviews/{interviewId} {
      allow read: if isAuthenticated();
      allow write: if isRecruiter() || isTPO();
    }

    // 6. Student Directory & Credentials Vault
    match /students/{rollNo} {
      allow read: if isAuthenticated();
      allow write: if isTPO();
    }

    match /credentials/{credId} {
      allow read: if isAuthenticated();
      allow write: if isTPO();
    }

    // 7. Recruiters & Analytics
    match /recruiters/{recruiterId} {
      allow read: if isAuthenticated();
      allow write: if isRecruiter() || isTPO();
    }
  }
}

